rules_version = '2';

// Online rooms for Stock Market and Plunder. There's no game server: each phone applies the rules
// itself, so these checks keep players honest about *who* may write and *when*.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // None of `keys` changed in this update.
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // The only change to the member list is the writer adding or removing themselves.
    function onlySelfJoinsOrLeaves() {
      let before = resource.data.memberUids.toSet();
      let after = request.resource.data.memberUids.toSet();
      return after.difference(before).hasOnly([request.auth.uid])
        && before.difference(after).hasOnly([request.auth.uid]);
    }

    match /stockMarketRooms/{code} {
      // Anyone signed in who knows the code can watch.
      allow read: if signedIn();

      // A new room starts as an empty lobby hosted by its creator.
      allow create: if signedIn()
        && code.size() <= 1500
        && code.matches('^[A-Z0-9]{3,}$')
        && request.resource.data.code == code
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.get('startWithCash', false) is bool
        && request.resource.data.get('balancedCareers', false) is bool
        && request.resource.data.version == 0
        && request.resource.data.memberUids == [request.auth.uid];

      // Lobby: the host may change anything (including starting the game);
      // anyone else may only take or give up their own seat.
      allow update: if signedIn()
        && resource.data.status == 'lobby'
        && unchanged(['code', 'hostUid', 'createdAt'])
        && request.resource.data.get('startWithCash', false) is bool
        && request.resource.data.get('balancedCareers', false) is bool
        && (
          request.auth.uid == resource.data.hostUid
          || (
            request.resource.data.status == 'lobby'
            && unchanged(['target', 'botLevel', 'startWithCash', 'balancedCareers', 'version', 'stateJson', 'replayJson', 'currentUid'])
            && onlySelfJoinsOrLeaves()
          )
        );

      // Game: seated players only, one version at a time, and only on their own
      // turn or a bot's turn.
      allow update: if signedIn()
        && resource.data.status == 'playing'
        && request.auth.uid in resource.data.memberUids
        && unchanged(['code', 'hostUid', 'createdAt', 'seats', 'memberUids', 'status', 'target', 'botLevel', 'startWithCash', 'balancedCareers'])
        && request.resource.data.version == resource.data.version + 1
        && (
          resource.data.currentUid == request.auth.uid
          || resource.data.currentUid == null
        );

      // Game: the host may remove a player (a bot takes their seat). Seats keep their number,
      // exactly one member leaves, and the host stays.
      allow update: if signedIn()
        && resource.data.status == 'playing'
        && request.auth.uid == resource.data.hostUid
        && unchanged(['code', 'hostUid', 'createdAt', 'status', 'target', 'botLevel', 'startWithCash', 'balancedCareers'])
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.seats.size() == resource.data.seats.size()
        && request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).size() == 0
        && resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).size() == 1
        && request.auth.uid in request.resource.data.memberUids;

      allow delete: if signedIn() && request.auth.uid == resource.data.hostUid;
    }

    match /stockMarketPresence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'status', 'seenAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 16
        && request.resource.data.status in ['home', 'lobby', 'playing']
        && request.resource.data.seenAt == request.time;
    }

    // Plunder online rooms: the same shape and rules as Stock Market's (no target or bot level).
    // `currentUid` is whoever the game waits on, which can be someone answering a trade or
    // deciding on a bribe in the middle of another player's turn.
    match /plunderRooms/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{5}$')
        && request.resource.data.code == code
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.version == 0
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if signedIn()
        && resource.data.status == 'lobby'
        && unchanged(['code', 'hostUid', 'createdAt'])
        && (
          request.auth.uid == resource.data.hostUid
          || (
            request.resource.data.status == 'lobby'
            && unchanged(['version', 'stateJson', 'replayJson', 'currentUid'])
            && onlySelfJoinsOrLeaves()
          )
        );

      allow update: if signedIn()
        && resource.data.status == 'playing'
        && request.auth.uid in resource.data.memberUids
        && unchanged(['code', 'hostUid', 'createdAt', 'seats', 'memberUids', 'status'])
        && request.resource.data.version == resource.data.version + 1
        && (
          resource.data.currentUid == request.auth.uid
          || resource.data.currentUid == null
        );

      allow delete: if signedIn() && request.auth.uid == resource.data.hostUid;
    }
  }
}
